#!/usr/sbin/nft -f
# Pare-feu du serveur (axe R4) — politique « tout refuser » en entrée, ouverture explicite.
# Adapter les réseaux ci-dessous, puis : sudo nft -c -f pare-feu.nft (contrôle) ; sudo nft -f pare-feu.nft
# Déploiement Docker : Docker gère ses propres chaînes (DOCKER-USER) ; ces règles filtrent l'accès à l'hôte.

define LAN_UTILISATEURS = 10.0.0.0/8          # postes autorisés à ouvrir la plateforme (HTTPS)
define ADMINS = 10.10.5.0/24                   # postes d'administration (SSH)
define SYSLOG_SIEM = 10.10.9.20                # collecteur syslog / SIEM

flush ruleset

table inet filtre {
    chain entree {
        type filter hook input priority 0; policy drop;
        ct state established,related accept
        ct state invalid drop
        iif lo accept
        ip protocol icmp icmp type { echo-request, destination-unreachable, time-exceeded } limit rate 10/second accept
        ip6 nexthdr icmpv6 accept

        ip saddr $LAN_UTILISATEURS tcp dport { 80, 443 } accept
        ip saddr $ADMINS tcp dport 22 ct state new limit rate 6/minute accept

        log prefix "pare-feu refus : " level info limit rate 5/second
    }
    chain transfert {
        type filter hook forward priority 0; policy accept;   # géré par Docker pour les conteneurs
    }
    chain sortie {
        type filter hook output priority 0; policy accept;
        # Durcissement possible : restreindre la sortie aux dépôts de paquets, SMTP, syslog ($SYSLOG_SIEM) et NTP
    }
}
