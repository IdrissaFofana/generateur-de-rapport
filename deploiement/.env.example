# Configuration du déploiement Docker (copier en deploiement/.env, puis : chmod 600 deploiement/.env)
# Secrets à générer : python3 -c "import secrets; print(secrets.token_urlsafe(48))"

VERSION=1.0
TZ=Africa/Abidjan

# Base de données (le conteneur « db » n'est joignable que depuis le réseau interne « donnees »)
POSTGRES_USER=rapports
POSTGRES_PASSWORD=
POSTGRES_DB=rapports_esay

# Application
SECRET_KEY=
URL_PLATEFORME=https://rapports.esay.local
PRESTATAIRE_NOM=ESAY
PRESTATAIRE_NOM_COMPLET=ESAY Corporation
EXIGER_2FA_ROLES=admin,validateur

# Supervision (R3) : jeton lu par Prometheus ; collecteur syslog / SIEM (journal d'audit et événements de sécurité)
METRIQUES_JETON=
SYSLOG_HOTE=
SYSLOG_PORT=514
SYSLOG_PROTOCOLE=udp

# Notifications (facultatif)
SMTP_HOTE=
SMTP_PORT=587
SMTP_EXPEDITEUR=
ALERTES_EMAILS=
RESUME_EMAILS=
TEAMS_WEBHOOK=

# Certificats TLS du proxy (rapports.crt / rapports.key) : autorité interne de l'entreprise de préférence
CERTIFICATS=./deploiement/certificats
