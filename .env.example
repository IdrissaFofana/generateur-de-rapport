DATABASE_URL="postgresql://UTILISATEUR:MOT_DE_PASSE@localhost:5432/rapports_esay?schema=public"
PORT=8010
SECRET_KEY="à générer : python -c \"import secrets; print(secrets.token_urlsafe(48))\""
STOCKAGE_DIR="/srv/rapports-esay/donnees"
# Sur le poste de développement Windows uniquement :
# WEASYPRINT_EXE="C:/chemin/vers/weasyprint.exe"

# Adresse de la plateforme (liens dans les e-mails et Teams)
URL_PLATEFORME="https://rapports.esay.local"

# --- Notifications (facultatif) : sans configuration, les alertes restent visibles dans la plateforme
# Serveur de messagerie interne (relais SMTP)
# SMTP_HOTE="mail.esay.local"
# SMTP_PORT=587
# SMTP_SECURITE=starttls          # starttls | ssl | aucune
# SMTP_UTILISATEUR=""
# SMTP_MOT_DE_PASSE=""
# SMTP_EXPEDITEUR="Rapports sécurité ESAY <rapports@esay.ci>"
# ALERTES_EMAILS="soc@esay.ci"
# RESUME_EMAILS="direction@esay.ci, soc@esay.ci"
# Teams : URL du workflow « Lorsqu'une requête webhook est reçue » (nécessite un accès sortant à internet)
# TEAMS_WEBHOOK=""
# Seuils
# SEUIL_HAUSSE_DETECTIONS_PCT=50
# SEUIL_SOUS_UTILISATION_PCT=70
# Authentification : verrouillage après N échecs, limitation par adresse IP, 2FA obligatoire par rôle
# VERROUILLAGE_ECHECS=5
# VERROUILLAGE_MINUTES=15
# LIMITE_ECHECS_IP=20
# EXIGER_2FA_ROLES="admin,validateur"
# Engagement interne : rapport validé au plus tard N jours après la fin du mois
# ENGAGEMENT_DELAI_JOURS=10

# Supervision : jeton de /metrics (vide = route désactivée) ; collecteur syslog / SIEM (vide = désactivé)
# METRIQUES_JETON=
# SYSLOG_HOTE=
# SYSLOG_PORT=514
# SYSLOG_PROTOCOLE=udp
